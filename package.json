{
  "name": "bulgarian-subtitle-translator",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Desktop app that extracts embedded subtitles and writes Bulgarian SRT files with preserved timings.",
  "repository": {
    "type": "git",
    "url": "https://github.com/warbladebg/SubsTranslate.git"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env SUBSTRANSLATE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run build && electron .",
    "install-windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-shortcut.ps1",
    "setup:torrent": "python -m pip install --target sidecars/libtorrent/vendor --upgrade -r sidecars/libtorrent/requirements.txt",
    "test:torrent-engine": "python -m unittest discover -s sidecars/libtorrent -p test_engine.py",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "benchmark:pgs": "npm run build:electron && node scripts/benchmark-pgs.cjs",
    "test": "vitest run",
    "test:gemini": "cross-env RUN_REAL_GEMINI_TESTS=true vitest run tests/geminiProvider.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.27.0",
    "pngjs": "^7.0.0",
    "ppu-paddle-ocr": "^6.0.0",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  }
}
